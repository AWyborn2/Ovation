# Ovation environment variables.
# Copy to .env (never committed) or set in the deployment. Grouped by concern;
# everything not marked "required" has a sensible default.

# ── Required ─────────────────────────────────────────────────────────────────
# Tenant application database (Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ovation
# Read-only central PCA database (Postgres schema `central`). Use a SELECT-only
# role with default_transaction_read_only=on. Never commit the real password.
CENTRAL_DATABASE_URL=postgresql://central_ro:password@host:5432/postgres?sslmode=require
# HMAC key for session cookies. Any long random string; rotating it signs
# everyone out.
SESSION_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Tenancy ──────────────────────────────────────────────────────────────────
# Apex/marketing hosts that serve the platform landing page (comma-separated).
PLATFORM_HOSTS=ovationcc.app,www.ovationcc.app
# Base domain used to build tenant URLs ({slug}.{base}).
PLATFORM_BASE_DOMAIN=ovationcc.app
# Tenant served on localhost/previews when no host matches (default 1 = demo).
DEFAULT_TENANT_ID=1
# Shared secret the tenant-domain proxy presents with X-Ovation-Host.
PROXY_SHARED_SECRET=
# Set to 0 on deployments without a trusted edge rewriting X-Forwarded-Host.
TRUST_FORWARDED_HOST=1
# Set to 1 to allow the x-tenant-id dev switcher on the published *.replit.app host.
TENANT_HEADER_ON_PUBLISHED_HOST=0
# Self-serve signup: pca | off
SIGNUP_MODE=pca

# ── Central reads ────────────────────────────────────────────────────────────
# Incident kill-switch: 0 forces tenant #1 to native and makes central tenants
# return 503 (never another club's data).
CENTRAL_READS=1
CENTRAL_CACHE_TTL_MS=300000
MILESTONES_CACHE_TTL_MS=300000
TENANT_ACTIVITY_THROTTLE_MS=600000
# Pool bounds (both databases).
POOL_MAX=10
POOL_IDLE_TIMEOUT_MS=30000
POOL_CONNECTION_TIMEOUT_MS=10000
STATEMENT_TIMEOUT_MS=30000
CENTRAL_POOL_MAX=5
CENTRAL_POOL_IDLE_TIMEOUT_MS=30000
CENTRAL_POOL_CONNECTION_TIMEOUT_MS=10000
CENTRAL_STATEMENT_TIMEOUT_MS=30000

# ── Billing (dormant) ────────────────────────────────────────────────────────
BILLING_ENABLED=false
STRIPE_SECRET_KEY=

# ── Object storage ───────────────────────────────────────────────────────────
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ── Card video rendering ─────────────────────────────────────────────────────
RENDER_HARNESS_URL=
RENDER_HARNESS_ORIGIN=
CHROMIUM_PATH=
PUPPETEER_EXECUTABLE_PATH=

# ── First-boot seeding (no-ops when unset or when an admin already exists) ───
ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Web build ────────────────────────────────────────────────────────────────
BASE_PATH=/

# ── Mobile (Expo) ────────────────────────────────────────────────────────────
EXPO_PUBLIC_DOMAIN=

# ── Replit-only (set by the platform) ────────────────────────────────────────
# REPLIT_DOMAINS, REPLIT_DEV_DOMAIN, REPL_ID, EXPO_PUBLIC_REPL_ID,
# REPLIT_INTERNAL_APP_DOMAIN

# ── Tests / scripts ──────────────────────────────────────────────────────────
# CI_SKIP_DATA_TESTS=true   skips suites that need the demo club's full history
# RUN_CARD_RENDER_SMOKE=1   runs the Chromium render smoke test
# SEED_TENANT_ID=1          target tenant for seed scripts (or pass --tenant)
# DRY_RUN=1                 preview seed scripts without writing
