# Ovation environment variables.
# Copy to .env (never committed) or set in the deployment. Grouped by concern;
# everything not marked "required" has a sensible default.

# ── Required ─────────────────────────────────────────────────────────────────
# Tenant application database (Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ovation
# Read-only central PCA database (Postgres schema `central`). Use a SELECT-only
# role with default_transaction_read_only=on. Never commit the real password.
CENTRAL_DATABASE_URL=postgresql://central_ro:password@host:5432/postgres
# TLS for the central pool: 1 = verify the server certificate (default for any
# non-loopback host), 0 = plain TCP (local Postgres / CI). Set explicitly rather
# than relying on ?sslmode=require, which pg does not verify by default.
CENTRAL_DB_SSL=1
# HMAC key for session cookies. Any long random string; rotating it signs
# everyone out.
SESSION_SECRET=change-me

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Tenancy ──────────────────────────────────────────────────────────────────
# Apex/marketing hosts that serve the platform landing page (comma-separated).
PLATFORM_HOSTS=ovationcc.app,www.ovationcc.app
# Base domain used to build tenant URLs ({slug}.{base}).
PLATFORM_BASE_DOMAIN=ovationcc.app
# Tenant served on localhost/previews when no host matches (default 1 = demo).
DEFAULT_TENANT_ID=1
# Shared secret the tenant-domain proxy presents with X-Ovation-Host.
PROXY_SHARED_SECRET=
# Set to 0 on deployments without a trusted edge rewriting X-Forwarded-Host.
TRUST_FORWARDED_HOST=1
# Set to 1 to allow the x-tenant-id dev switcher on the published *.replit.app host.
TENANT_HEADER_ON_PUBLISHED_HOST=0
# Self-serve signup: pca | off
SIGNUP_MODE=pca

# ── Central reads ────────────────────────────────────────────────────────────
# Incident kill-switch: 0 forces tenant #1 to native and makes central tenants
# return 503 (never another club's data).
CENTRAL_READS=1
CENTRAL_CACHE_TTL_MS=300000
MILESTONES_CACHE_TTL_MS=300000
TENANT_ACTIVITY_THROTTLE_MS=600000
# Pool bounds (both databases).
POOL_MAX=10
POOL_IDLE_TIMEOUT_MS=30000
POOL_CONNECTION_TIMEOUT_MS=10000
STATEMENT_TIMEOUT_MS=30000
CENTRAL_POOL_MAX=5
CENTRAL_POOL_IDLE_TIMEOUT_MS=30000
CENTRAL_POOL_CONNECTION_TIMEOUT_MS=10000
CENTRAL_STATEMENT_TIMEOUT_MS=30000

# ── Billing (dormant) ────────────────────────────────────────────────────────
BILLING_ENABLED=false
STRIPE_SECRET_KEY=

# ── Object storage ───────────────────────────────────────────────────────────
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# ── Social Studio drafting sweep ─────────────────────────────────────────────
# Shared secret for POST /api/internal/draft-sweep (the scheduled job and the
# fixtures projection script send it as x-sweep-secret). Unset = endpoint closed.
SOCIAL_SWEEP_SECRET=
# Where scripts/src/playhq-project-fixtures.ts asks for a sweep after it
# commits, e.g. https://<app>/api/internal/draft-sweep. Unset = it only logs.
SOCIAL_SWEEP_URL=

# ── Meta publishing (docs/runbooks/meta-publishing.md) ───────────────────────
# Platform kill switch: "1" turns connect + publish on. Anything else = off.
META_PUBLISHING_ENABLED=
# The Ovation Meta app (Business type) and its Facebook Login for Business config.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Pinned Graph API version (default v26.0).
META_GRAPH_VERSION=
# Page-token encryption key: 32 random bytes, base64. Replit Secrets only.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_KEY=
# Version of SOCIAL_TOKEN_KEY (default 1). Bump it when rotating, and move the
# old key to SOCIAL_TOKEN_KEY_PREVIOUS as "<version>:<base64>" until re-sealed.
SOCIAL_TOKEN_KEY_VERSION=
SOCIAL_TOKEN_KEY_PREVIOUS=
# Absolute https origin Meta fetches images from and the OAuth callback lives
# on, e.g. https://ovationcc.app. Must serve /api for every tenant.
SOCIAL_PUBLIC_ORIGIN=
# Shared secret for POST /api/internal/publish-sweep (x-publish-secret).
# Must differ from SOCIAL_SWEEP_SECRET. Unset = endpoint closed.
SOCIAL_PUBLISH_SECRET=

# ── PlayHQ scheduled sync ────────────────────────────────────────────────────
# Shared secret for POST /api/internal/playhq/ingest (the sync runner sends it as
# x-sync-secret). Unset = endpoint closed.
PLAYHQ_SYNC_SECRET=
# Write connection for that endpoint: the `playhq_ingest` role, which may write
# schema playhq only (scripts/sql/playhq-ingest-role.sql). Never the central
# read-only URL and never a superuser — the API refuses either. Unset = 503.
PLAYHQ_INGEST_DATABASE_URL=
# TLS for it: unset = verified TLS unless the host is local; 0 disables.
PLAYHQ_INGEST_DB_SSL=
# PlayHQ → central stats projection after each ingest: off (default) | dry | on.
CENTRAL_PROJECTION=
# Write connection for it: the `central_projector` role, which may write only the central
# match, line and player tables (scripts/sql/central-projector.sql). Never the central
# read-only URL and never a superuser — the API refuses either.
CENTRAL_PROJECTOR_DATABASE_URL=
# TLS for it: unset = verified TLS unless the host is local; 0 disables.
CENTRAL_PROJECTOR_DB_SSL=
# Where sync incident alerts are emailed (needs RESEND_API_KEY + EMAIL_FROM).
# Unset = PLATFORM_ADMIN_EMAIL; neither = alerts stay in the platform console.
PLATFORM_ALERT_EMAIL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Draft notifications by email. Both unset = notifications stay in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Availability requests and selection notices by SMS. SID or token unset = SMS
# off (email only). Sender is a two-way Australian number (TWILIO_FROM, E.164)
# or a Messaging Service SID with Advanced Opt-Out on — never an alphanumeric ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ── Studio tools ─────────────────────────────────────────────────────────────
# Photoroom background removal for library photos. Unset = the tool is hidden.
PHOTOROOM_API_KEY=
# Open-Meteo match-day forecasts need no key on the free (non-commercial) API.
# Set a commercial key here before charging clubs; it switches to the customer API.
OPEN_METEO_API_KEY=

# ── Google Drive photo import ────────────────────────────────────────────────
# Google Picker in the Photo library (drive.file scope: only picked files).
# All three unset = the import button is hidden.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=

# ── Card video rendering ─────────────────────────────────────────────────────
RENDER_HARNESS_URL=
RENDER_HARNESS_ORIGIN=
CHROMIUM_PATH=
PUPPETEER_EXECUTABLE_PATH=

# ── First-boot seeding (no-ops when unset or when an admin already exists) ───
ADMIN_PASSWORD=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Web build ────────────────────────────────────────────────────────────────
BASE_PATH=/

# ── Mobile (Expo) ────────────────────────────────────────────────────────────
# API host the app calls. In production point it at the TENANT'S OWN host
# (subdomain / custom domain) — the API resolves the tenant from the host.
EXPO_PUBLIC_DOMAIN=
# Dev/preview only: pins the tenant via the x-tenant-id header (the API ignores
# it on real tenant hosts). Positive integer tenants.id, e.g. 1 = Halls Head.
EXPO_PUBLIC_TENANT_ID=
# Per-tenant store identity, read by app.config.ts at build time.
EXPO_PUBLIC_TENANT_NAME=Ovation
EXPO_PUBLIC_TENANT_SLUG=ovation
# iOS bundleIdentifier / Android package. Default: app.ovation.<slug>
EXPO_PUBLIC_BUNDLE_ID=

# ── Replit-only (set by the platform) ────────────────────────────────────────
# REPLIT_DOMAINS, REPLIT_DEV_DOMAIN, REPL_ID, EXPO_PUBLIC_REPL_ID,
# REPLIT_INTERNAL_APP_DOMAIN

# ── Tests / scripts ──────────────────────────────────────────────────────────
# CI_SKIP_DATA_TESTS=true   skips suites that need the demo club's full history
# RUN_CARD_RENDER_SMOKE=1   runs the Chromium render smoke test
# SEED_TENANT_ID=1          target tenant for seed scripts (or pass --tenant)
# DRY_RUN=1                 preview seed scripts without writing
