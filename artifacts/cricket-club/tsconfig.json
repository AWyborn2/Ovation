{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // Pin React's types to this app's copy. The mobile app needs a newer
      // @types/react; a workspace lib source with no copy of its own would
      // otherwise resolve whichever version pnpm hoisted to the root, and two
      // React type copies in one program fail with "two different types with
      // this name exist" (seen intermittently in CI on cricket-cap.tsx).
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/object-storage-web"
    },
    {
      "path": "../../lib/scorecard"
    }
  ]
}
