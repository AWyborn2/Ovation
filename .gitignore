# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Claude Code local worktrees (ce-work isolation), never shared state
.claude/worktrees/

# Claude Code skill symlinks -> .agents/skills/ (source of truth); on
# platforms without symlink support these dereference into duplicate copies
.claude/skills/

# Claude Code personal overrides (permissions, local instructions) - not team policy
.claude/settings.local.json
CLAUDE.local.md

# design-sync machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Impeccable design-hook local state (the shared .impeccable/config.json IS committed)
.impeccable/hook.cache.json
.impeccable/config.local.json
artifacts/*/.impeccable/hook.cache.json
artifacts/*/.impeccable/config.local.json

# Database dumps and archives never belong in git (they carry participant data
# and weigh hundreds of MB). Keep them in object storage; see scripts/README.md.
attached_assets/*.sql
attached_assets/*.db
attached_assets/*.zip
# Local environment files
.env
.env.*
!.env.example
# Mobile static build output
artifacts/cricket-mobile/static-build/
