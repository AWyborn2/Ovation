{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./central": "./src/central.ts",
    "./central-queries": "./src/central-queries.ts",
    "./provision": "./src/provision.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "generate:custom": "drizzle-kit generate --custom --config ./drizzle.config.ts",
    "migrate": "tsx ./src/migrate.ts",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "push-central": "drizzle-kit push --force --config ./drizzle.central.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
